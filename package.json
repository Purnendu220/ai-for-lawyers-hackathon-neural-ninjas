{
  "name": "casepilot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions",
    "apps/*",
    "tests/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @casepilot/web",
    "dev:emulator": "npm run dev:emulator -w @casepilot/web",
    "emulators": "npm run build -w @casepilot/functions && firebase emulators:start --project demo-casepilot",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "firebase emulators:exec --project demo-casepilot --only firestore \"npm run test:emulator -w @casepilot/rules-tests\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
