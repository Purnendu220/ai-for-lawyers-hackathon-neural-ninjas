# Non-secret function configuration, loaded by the emulator and by `firebase deploy`.
# Per-project overrides go in .env.<projectId> (for example .env.casepilot-demo).
# Secrets (OPENAI_API_KEY) go in Secret Manager: firebase functions:secrets:set OPENAI_API_KEY

# Turn on once the web app sends App Check tokens (implementation plan, Day 7).
ENFORCE_APP_CHECK=false
