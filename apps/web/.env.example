# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# The Firebase web config is public by design. Never put the OpenAI key (or any secret) here.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key registered for App Check. Leave empty to skip App Check.
VITE_APPCHECK_SITE_KEY=
