# Used by `npm run dev:emulator`. Points the app at the local Firebase Emulator Suite
# (project demo-casepilot). These are placeholder values, not credentials.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-casepilot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-casepilot
VITE_FIREBASE_STORAGE_BUCKET=demo-casepilot.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_APPCHECK_SITE_KEY=
